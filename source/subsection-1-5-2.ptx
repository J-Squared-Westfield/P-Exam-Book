<subsection xml:id="subsection-1-5-2">
    <title>Exercises</title>
    <exercise xml:id="ex-extreme-values-1">
        <title>Minimum and Maximum Values 1</title>
        <webwork>
            <pg-code><![CDATA[
            Context("Numeric");
            Context()->variables->are(x=>"Real");

            $a = list_random(1..3);
            $b = list_random(2..4);

            $right_endpoint = $b;
            $left_endpoint = -$a;

            $max_abs = ($a > $b) ? $a : $b;

            $min_value = exp(-$max_abs**2);
            $max_value = 1;

            $ans_min = Compute($min_value);
            $ans_max = Compute($max_value);

            $min_rounded = sprintf("%.9f", $min_value);
                ]]></pg-code>

            <statement>
                <p>
                    Find the minimum and maximum values of the function
                    <m>f(x)=e^{-x^2}</m> on
                    <m>[<var name="$left_endpoint"/>,<var name="$right_endpoint"/>]</m>.
                </p>

                <p>
                    Minimum value: <var name="$ans_min" width="15"/>
                </p>

                <p>
                    Maximum value: <var name="$ans_max" width="15"/>
                </p>
            </statement>

            <solution>
                <p>
                    Since
                    <md>
                    \begin{aligned}
                    f'(x) &amp;= -2xe^{-x^2},
                    \end{aligned}
                    </md>
                    the only critical point is <m>x=0</m>. The maximum occurs at <m>x=0</m>, giving
                    <m>f(0)=1</m>. The minimum occurs at the endpoint farthest from <m>0</m>, so the minimum value is
                    <m>e^{-16} approx var name="$min_rounded"/></m>.
                </p>
            </solution>
        </webwork>
    </exercise>


    <exercise xml:id="ex-extreme-values-2">
        <title>Mode of a Density Function 1</title>
        <webwork>
            <pg-code><![CDATA[
        Context("Numeric");

        $l = list_random(2..6);

        $ans = Compute(0);
            ]]></pg-code>

            <statement>
                <p>
                    A density function is given by
                    <m>f(x)=\frac{1}{<var name="$l"/>}e^{-x/<var name="$l"/>}</m>
                    for <m>x\geq 0</m>. The mode is defined as the <m>x</m> value that maximizes
                    <m>f(x)</m>. Find the mode of <m>f(x)</m>.
                </p>

                <p>
                    Mode: <var name="$ans" width="10"/>
                </p>
            </statement>

            <solution>
                <p>
                    Since
                    <md>
                    \begin{aligned}
                    f'(x)
                    &amp;= -\frac{1}{<var name="$l"/>^2}e^{-x/<var name="$l"/>},
                    \end{aligned}
                    </md>
                    the derivative is always negative for <m>x\geq 0</m>. Therefore, the density is decreasing on its domain, so its maximum occurs at the left endpoint. The mode is <m>x=0</m>.
                </p>
            </solution>
        </webwork>
    </exercise>


    <exercise xml:id="ex-extreme-values-3">
        <title>Mode of a Density Function 2</title>
        <webwork>
            <pg-code><![CDATA[
                Context("Numeric");
                Context()->variables->are(x=>"Real", L=>"Real");

                $ans = Compute(0);
                    ]]>
            </pg-code>

            <statement>
                <p>
                    A density function is given by
                    <m>f(x)=\frac{1}{L}e^{-x/L}</m>
                    for <m>x\geq 0</m>, where <m>L</m> is a positive constant.
                    Find the mode of <m>f(x)</m>.
                </p>

                <p>
                    Mode: <var name="$ans" width="10"/>
                </p>
            </statement>

            <solution>
                <p>
                    Since <m>L&gt;0</m>,
                    <md>
                    \begin{aligned}
                    f'(x)
                    &amp;= -\frac{1}{L^2}e^{-x/L}.
                    \end{aligned}
                    </md>
                    This is negative for every <m>x\geq 0</m>. 
                    Therefore, <m>f(x)</m> is decreasing on its domain, so the maximum occurs at the left endpoint. 
                    The mode is <m>x=0</m>.
                </p>
            </solution>
        </webwork>
    </exercise>


    <exercise xml:id="ex-extreme-values-4">
        <title>Minimum and Maximum Values 2</title>
        <webwork>
            <pg-code>
                <![CDATA[
                Context("Numeric");
                Context()->variables->are(x=>"Real", m=>"Real", s=>"Real");

                $ans_max = Formula("1/(s*sqrt(2*pi))");

                loadMacros(
                "parserCheckboxList.pl",
                );

                $min_check = CheckboxList(
                [
                    'A minimum value exists and is \(0\).',
                    'No minimum value exists.',
                    'A minimum value exists at \(x=m\).'
                ],
                [
                    'No minimum value exists.'
                ],
                labels => "ABC",
                displayLabels => 1
                );]]>
            </pg-code>

            <statement>
                <p>
                    Let
                    <m>f(x)=\frac{1}{s\sqrt{2\pi}}e^{-\frac{(x-m)^2}{2s^2}}</m>
                    on <m>(-\infty,\infty)</m>, where <m>s&gt;0</m> and <m>m</m> are constants.
                    Find the minimum and maximum values of <m>f(x)</m>, if they exist.
                </p>

                <p>
                    Which statement about the minimum value is correct?
                    <var name="$min_check" form="checkboxes"/>
                </p>

                <p>
                    Maximum value: <var name="$ans_max" width="35"/>
                </p>
            </statement>

            <solution>
                <p>
                    <m>\frac{1}{s\sqrt{2\pi}}</m> is a constant.
                    The derivative of <m>e^{-\frac{(x-m)^2}{2s^2}}</m> is
                    <md>
                        \begin{aligned}
                        \frac{d}{dx}e^{-\frac{(x-m)^2}{2s^2}}
                        &amp;= e^{-\frac{(x-m)^2}{2s^2}}\left(-\frac{1}{2s^2}\right)\left(2(x-m)\right)\\
                        &amp;= -\frac{(x-m)}{s^2}e^{-\frac{(x-m)^2}{2s^2}}.
                        \end{aligned}
                    </md>
                    Setting this equal to zero, we find the critical point <m>x=m</m>.
                </p>
                <p>
                    Plugging in give <m>\displaystyle f(m) = \frac{1}{s\sqrt{2\pi}}</m>.  
                    This is the maximum value. 
                </p>

                <p>
                    As <m>x\to\infty</m> or <m>x\to -\infty</m>, the function approaches <m>0</m>, but it never equals <m>0</m>. 
                    Therefore, no minimum value exists.
                </p>
            </solution>
        </webwork>
    </exercise>

    <exercise xml:id="ex-extreme-values-5">
        <title>Minimum and Maximum Values 3</title>
        <webwork>
            <pg-code>
                <![CDATA[
                Context("Numeric");
                Context()->variables->are(x=>"Real");

                $h = list_random(3..6);
                $k = list_random(1..4);
                $L = 10;

                $left_value = ($h**2)/10 + $k;
                $right_value = (($L-$h)**2)/10 + $k;

                $max_value = ($left_value > $right_value) ? $left_value : $right_value;
                $min_value = $k;

                $ans_min = Compute($min_value);
                $ans_max = Compute($max_value);

                $left_rounded = sprintf("%.1f", $left_value);
                $right_rounded = sprintf("%.1f", $right_value);
                $max_rounded = sprintf("%.1f", $max_value);
                    ]]>
            </pg-code>

            <statement>
                <p>
                    Find the minimum and maximum values of
                    <m>f(x)=\frac{1}{10}(x-<var name="$h"/>)^2+<var name="$k"/></m>
                    on <m>[0,10]</m>.
                </p>

                <p>
                    Minimum value: <var name="$ans_min" width="15"/>
                </p>

                <p>
                    Maximum value: <var name="$ans_max" width="15"/>
                </p>
            </statement>

            <solution>
                <p>
                    The function is written in vertex form. Since the coefficient of the squared term is positive, the minimum occurs at the vertex:
                    <md>
                    \begin{aligned}
                    x &amp;= <var name="$h"/>,\\
                    f(<var name="$h"/>) &amp;= <var name="$k"/>.
                    \end{aligned}
                    </md>
                    To find the maximum on the closed interval, compare the endpoint values:
                    <md>
                    \begin{aligned}
                    f(0) &amp;= <var name="$left_rounded"/>,\\
                    f(10) &amp;= <var name="$right_rounded"/>.
                    \end{aligned}
                    </md>
                    Therefore, the maximum value is <m><var name="$max_rounded"/></m>.
                </p>
            </solution>
        </webwork>
    </exercise>


    <exercise xml:id="ex-extreme-values-6">
        <title>Mode of a Density Function 3</title>
        <webwork>
            <pg-code>
                <![CDATA[
                Context("Numeric");
                Context()->variables->are(x=>"Real", k=>"Real", t=>"Real");

                $ans = Formula("t*(k-1)");
                    ]]>
            </pg-code>

            <statement>
                <p>
                    A density function is given by
                    <m>f(x)=\frac{1}{k!t^k}x^{k-1}e^{-x/t}</m>,
                    where <m>x&gt;0</m> and <m>k,t&gt;1</m> are constants.
                    Find the mode of <m>f(x)</m>.
                </p>

                <p>
                    Mode: <var name="$ans" width="25"/>
                </p>
            </statement>

            <solution>
                <p>
                    The constant factor <m>\frac{1}{k!t^k}</m> is positive, so it does not affect where the maximum occurs. Differentiate the part depending on <m>x</m>:
                    <md>
                    \begin{aligned}
                    \frac{d}{dx}\left(x^{k-1}e^{-x/t}\right)
                    &amp;= (k-1)x^{k-2}e^{-x/t}+x^{k-1}\left(-\frac{1}{t}e^{-x/t}\right)\\
                    &amp;= x^{k-2}e^{-x/t}\left((k-1)-\frac{x}{t}\right).
                    \end{aligned}
                    </md>
                    Since <m>x^{k-2}e^{-x/t}</m> is positive for <m>x&gt;0</m>, the critical point occurs when
                    <md>
                    \begin{aligned}
                    (k-1)-\frac{x}{t} &amp;= 0\\
                    x &amp;= t(k-1).
                    \end{aligned}
                    </md>
                    The function increases before this point and decreases after it, so the mode is <m>x=t(k-1)</m>.
                </p>
            </solution>
        </webwork>
    </exercise>
</subsection>