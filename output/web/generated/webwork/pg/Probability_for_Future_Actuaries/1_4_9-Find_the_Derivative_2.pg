);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real");

$a = list_random(2..6);
$b = list_random(1..5);

$ans = Formula("exp(x^2 - $a*x + $b)*(2*x - $a)");

############################################################
# Body
############################################################

BEGIN_PGML
Find the derivative of [`e^{x^2-[$a]x+[$b]}\text{.}`]

[`f'(x)=`] [_]{$ans}{40}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
Using the chain rule,

[```
          \begin{aligned}
          \frac{d}{dx}e^{x^2-[$a]x+[$b]}
          &= e^{x^2-[$a]x+[$b]}
          \left(2x-[$a]\right).
          \end{aligned}
        ```]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

ENDDOCUMENT();
