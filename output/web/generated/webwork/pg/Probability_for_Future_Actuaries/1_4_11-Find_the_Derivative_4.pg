  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real");

$a = list_random(3..9);
$b = list_random(2..7);

$ans = Formula("-$a*cos($b-x)");

############################################################
# Body
############################################################

BEGIN_PGML
Find the derivative of [`[$a]\sin([$b]-x)\text{.}`]

[`f'(x)=`] [_]{$ans}{40}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
Using the chain rule,

[```
          \begin{aligned}
          \frac{d}{dx}\left([$a]\sin([$b]-x)\right)
          &= [$a]\cos([$b]-x)(-1)\\
          &= -[$a]\cos([$b]-x).
          \end{aligned}
        ```]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

ENDDOCUMENT();
