TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real");

$ans = Formula("atan(x) + x/(1+x^2)");

############################################################
# Body
############################################################

BEGIN_PGML
Find the derivative of [`x\arctan(x)\text{.}`]

[`f'(x)=`] [_]{$ans}{40}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
Using the product rule,

[```
          \begin{aligned}
          \frac{d}{dx}\left(x\arctan(x)\right)
          &= 1\cdot \arctan(x) + x\cdot \frac{1}{1+x^2}\\
          &= \arctan(x)+\frac{x}{1+x^2}.
          \end{aligned}
        ```]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

