TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real", q=>"Real");

$ans = Formula("q^x*ln(q)");

############################################################
# Body
############################################################

BEGIN_PGML
Find the derivative of [`q^x\text{,}`] where [`q`] is a constant with [`0<q<1\text{.}`]

[`f'(x)=`] [_]{$ans}{40}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
For a positive constant base [`q\text{,}`]

[```
          \begin{aligned}
          \frac{d}{dx}q^x &= q^x\ln(q).
          \end{aligned}
        ```]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

