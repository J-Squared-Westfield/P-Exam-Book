DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real");

$a = list_random(1..3);
$b = list_random(2..4);

$right_endpoint = $b;
$left_endpoint = -$a;

$max_abs = ($a > $b) ? $a : $b;

$min_value = exp(-$max_abs**2);
$max_value = 1;

$ans_min = Compute($min_value);
$ans_max = Compute($max_value);

$min_rounded = sprintf("%.9f", $min_value);

############################################################
# Body
############################################################

BEGIN_PGML
Find the minimum and maximum values of the function [`f(x)=e^{-x^2}`] on [`[[$left_endpoint],[$right_endpoint]]\text{.}`]

Minimum value: [_]{$ans_min}{15}

Maximum value: [_]{$ans_max}{15}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
Since

[```
                    \begin{aligned}
                    f'(x) &= -2xe^{-x^2},
                    \end{aligned}
                    ```]

the only critical point is [`x=0\text{.}`] The maximum occurs at [`x=0\text{,}`] giving [`f(0)=1\text{.}`] The minimum occurs at the endpoint farthest from [`0\text{,}`] so the minimum value is [`e^{-16} approx var name="$min_rounded"/>\text{.}`]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

ENDDOCUMENT();
