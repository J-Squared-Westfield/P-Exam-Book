DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real");

$h = list_random(3..6);
$k = list_random(1..4);
$L = 10;

$left_value = ($h**2)/10 + $k;
$right_value = (($L-$h)**2)/10 + $k;

$max_value = ($left_value > $right_value) ? $left_value : $right_value;
$min_value = $k;

$ans_min = Compute($min_value);
$ans_max = Compute($max_value);

$left_rounded = sprintf("%.1f", $left_value);
$right_rounded = sprintf("%.1f", $right_value);
$max_rounded = sprintf("%.1f", $max_value);

############################################################
# Body
############################################################

BEGIN_PGML
Find the minimum and maximum values of [`f(x)=\frac{1}{10}(x-[$h])^2+[$k]`] on [`[0,10]\text{.}`]

Minimum value: [_]{$ans_min}{15}

Maximum value: [_]{$ans_max}{15}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
The function is written in vertex form. Since the coefficient of the squared term is positive, the minimum occurs at the vertex:

[```
                    \begin{aligned}
                    x &= [$h],\\
                    f([$h]) &= [$k].
                    \end{aligned}
                    ```]

To find the maximum on the closed interval, compare the endpoint values:

[```
                    \begin{aligned}
                    f(0) &= [$left_rounded],\\
                    f(10) &= [$right_rounded].
                    \end{aligned}
                    ```]

Therefore, the maximum value is [`[$max_rounded]\text{.}`]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

ENDDOCUMENT();
