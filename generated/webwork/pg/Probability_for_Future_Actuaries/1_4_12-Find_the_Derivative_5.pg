DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real");

$c = list_random(4..9);
$p = list_random(2..5);
$a = list_random(2..7);
$b = list_random(1..5);
$cp = $c*$p;

$ans = Formula("-$cp*x^(-$p-1) - $a/($a*x+$b)");

############################################################
# Body
############################################################

BEGIN_PGML
Find the derivative of [`\frac{[$c]}{x^{[$p]}}-\ln([$a]x+[$b])\text{.}`]

[`f'(x)=`] [_]{$ans}{40}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
Rewrite the first term using a negative exponent and use the chain rule on the logarithm:

[```
          \begin{aligned}
          \frac{d}{dx}\left([$c]x^{-[$p]}-\ln([$a]x+[$b])\right)
          &= -[$cp]x^{-[$p]-1}
          -\frac{[$a]}{[$a]x+[$b]}.
          \end{aligned}
        ```]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

ENDDOCUMENT();
