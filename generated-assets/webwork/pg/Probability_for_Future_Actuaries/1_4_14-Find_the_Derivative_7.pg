DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
Context("Numeric");
Context()->variables->are(x=>"Real");

$a = list_random(1..4);
$b = list_random(1..5);
$c = list_random(2..6);

$ans = Formula("((x^2+$b*x-$c) - (x-$a)*(2*x+$b))/(x^2+$b*x-$c)^2");

############################################################
# Body
############################################################

BEGIN_PGML
Find the derivative of [`\frac{x-[$a]}{x^2+[$b]x-[$c]}\text{.}`]

[`f'(x)=`] [_]{$ans}{50}

END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
Using the quotient rule,

[```
          \begin{aligned}
          \frac{d}{dx}\left(\frac{x-[$a]}{x^2+[$b]x-[$c]}\right)
          &= \frac{(x^2+[$b]x-[$c])
          -(x-[$a])(2x+[$b])}
          {(x^2+[$b]x-[$c])^2}.
          \end{aligned}
        ```]

END_PGML_SOLUTION

############################################################
# End Problem
############################################################

